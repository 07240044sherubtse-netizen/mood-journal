# MoodJournal - copy this file to .env and fill in your own values.
#   Copy-Item .env.example .env
# NEVER commit the real .env file (it is already in .gitignore).
#
# On Render (or any host) you do not upload this file - you type the same names
# and values into the service's "Environment" page instead. See DEPLOYMENT.md.

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=3000
# development (shows stack traces, allows http cookies) or production
NODE_ENV=development
# The full public address of the app, used to build the links inside the
# verification and password-reset emails. No trailing slash.
# Locally: http://localhost:3000   On Render: https://your-app.onrender.com
BASE_URL=http://localhost:3000
# Every "today" calculation uses this timezone.
TIMEZONE=Asia/Thimphu

# ---------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mood_journal
DB_USER=postgres
DB_PASS=your-database-password
# true for a cloud database (Neon, Render, ...), false for local Postgres
DB_SSL=false

# ---------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------
# A long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------
# Email (optional local SMTP; production Apps Script relay)
# ---------------------------------------------------------------------
# Local development sends real email through Gmail SMTP. Use the 16-character
# Gmail App Password, not your normal password (spaces are stripped). Render
# production uses the HTTPS Apps Script relay because SMTP may be blocked there.
# See DEPLOYMENT.md section 6 for its setup.
#
# MAIL_WEBHOOK_URL   = the Apps Script Web app URL (it ends in /exec)
# MAIL_WEBHOOK_SECRET = any long random string; store the same value in Apps
#                       Script Project Settings > Script Properties as MAIL_SECRET.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
