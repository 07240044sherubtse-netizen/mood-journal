<%- include('../partials/header', { title: 'Dashboard' }) %>

<section class="dashboard-hero" aria-label="Mood Journal highlights" data-carousel>
  <div class="dashboard-hero__slides">
    <div class="dashboard-hero__slide is-active"><img src="/images/mood1.jpg" alt="Peaceful landscape"></div>
    <div class="dashboard-hero__slide"><img src="/images/mood2.jpg" alt="A moment of calm"></div>
    <div class="dashboard-hero__slide"><img src="/images/mood3.webp" alt="A bright new day"></div>
  </div>
  <div class="dashboard-hero__shade" aria-hidden="true"></div>
  <div class="dashboard-hero__caption">
    <span class="eyebrow">A moment for you</span>
    <h2>Make space for how you feel.</h2>
    <p>Your thoughts, your pace, your own little corner of calm.</p>
  </div>
  <div class="dashboard-hero__dots" role="group" aria-label="Choose a featured image">
    <button class="dashboard-hero__dot is-active" type="button" aria-label="Show image 1" aria-pressed="true"></button>
    <button class="dashboard-hero__dot" type="button" aria-label="Show image 2" aria-pressed="false"></button>
    <button class="dashboard-hero__dot" type="button" aria-label="Show image 3" aria-pressed="false"></button>
  </div>
</section>

<div class="card">
  <p class="muted"><%= weekday %>, <%= today %></p>
  <h1><%= greeting %></h1>
  <p class="muted">How are you feeling today?</p>
</div>

<div class="grid-2">
  <div class="card streak-card">
    <p class="muted small">Current streak</p>
    <p class="streak-number"><span aria-hidden="true">🔥</span> <%= info.currentStreak %></p>
    <p class="muted small">
      <%= info.currentStreak === 1 ? 'day' : 'days' %> in a row
      &middot; longest: <%= info.longestStreak %>
    </p>
  </div>

  <div class="card message-card <%= message.celebrate ? 'message-card--celebrate' : '' %>">
    <h2><%= message.title %></h2>
    <p class="muted"><%= message.text %></p>
  </div>
</div>

<div class="card">
  <h2>Have you logged your mood today?</h2>

  <% if (todayEntry) { %>
    <% const mood = MOODS[todayEntry.mood]; %>
    <div class="mood-show" style="background: <%= mood.color %>; color: <%= mood.text %>">
      <span class="mood-show__emoji" aria-hidden="true"><%= mood.emoji %></span>
      <span class="mood-show__label"><%= mood.label %></span>
    </div>
    <% if (todayEntry.note) { %>
      <p class="note"><%= todayEntry.note %></p>
    <% } else { %>
      <p class="muted small">No note written today.</p>
    <% } %>
    <p>
      <button class="btn btn--primary" type="button" id="edit-today" aria-expanded="false"
              aria-controls="mood-form-wrap">Edit today&rsquo;s entry</button>
    </p>
  <% } else { %>
    <p class="muted">Choose the mood that fits you best right now.</p>
  <% } %>

  <div id="mood-form-wrap" class="<%= todayEntry ? 'is-hidden' : '' %>">
    <form class="form" action="/entries/today" method="post" id="mood-form">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

      <fieldset class="mood-picker">
        <legend class="sr-only">Choose your mood</legend>
        <% MOOD_LIST.forEach(function (mood) { %>
          <label class="mood-option">
            <input type="radio" name="mood" value="<%= mood.key %>"
                   <%= todayEntry && todayEntry.mood === mood.key ? 'checked' : '' %> required>
            <span class="mood-option__face" style="background: <%= mood.color %>; color: <%= mood.text %>">
              <span aria-hidden="true"><%= mood.emoji %></span>
              <span class="mood-option__name"><%= mood.label %></span>
            </span>
          </label>
        <% }); %>
      </fieldset>

      <label for="note">Note (optional, up to 200 characters)</label>
      <textarea id="note" name="note" rows="3" maxlength="200"
                placeholder="Anything you want to remember about today"><%= todayEntry ? todayEntry.note : '' %></textarea>
      <p class="hint"><span id="note-count">0</span>/200</p>

      <button class="btn btn--primary" type="submit">Save today&rsquo;s mood</button>
    </form>
  </div>
</div>

<div class="card">
  <h2>Last 7 days</h2>
  <ul class="week-strip">
    <% week.forEach(function (day) { %>
      <li class="week-day <%= day.isToday ? 'week-day--today' : '' %>">
        <span class="week-day__name"><%= day.weekday %></span>
        <% if (day.mood) { %>
          <% const mood = MOODS[day.mood]; %>
          <a class="week-day__dot" href="/entries/<%= day.date %>"
             style="background: <%= mood.color %>; color: <%= mood.text %>"
             title="<%= mood.label %>" aria-label="<%= day.date %>: <%= mood.label %>">
            <span aria-hidden="true"><%= mood.emoji %></span>
          </a>
        <% } else { %>
          <span class="week-day__dot week-day__dot--empty" title="No entry"
                aria-label="<%= day.date %>: no entry">&middot;</span>
        <% } %>
      </li>
    <% }); %>
  </ul>
  <p class="hint">Tap a day to look back at it.</p>
</div>

<section class="analytics-section" id="mood-analytics" data-today="<%= today %>">
  <div class="analytics-heading">
    <div>
      <span class="eyebrow">Your patterns, at a glance</span>
      <h2>Mood Analytics</h2>
      <p class="muted">A private look at the rhythms in your journal.</p>
    </div>
    <div class="analytics-tabs" role="group" aria-label="Analytics period">
      <button class="analytics-tab is-active" type="button" data-view="week" aria-pressed="true">Weekly</button>
      <button class="analytics-tab" type="button" data-view="month" aria-pressed="false">Monthly</button>
    </div>
  </div>

  <div class="analytics-summary" aria-live="polite">
    <article class="analytics-stat">
      <span class="analytics-stat__icon" aria-hidden="true">✦</span>
      <p class="muted small">All-time entries</p>
      <strong id="analytics-total">—</strong>
    </article>
    <article class="analytics-stat">
      <span class="analytics-stat__icon" aria-hidden="true">☼</span>
      <p class="muted small">Most common this month</p>
      <strong id="analytics-common">—</strong>
    </article>
    <article class="analytics-stat">
      <span class="analytics-stat__icon" aria-hidden="true">↗</span>
      <p class="muted small">Current streak</p>
      <strong id="analytics-current-streak">—</strong>
    </article>
    <article class="analytics-stat">
      <span class="analytics-stat__icon" aria-hidden="true">✧</span>
      <p class="muted small">Longest streak</p>
      <strong id="analytics-longest-streak">—</strong>
    </article>
  </div>

  <div class="analytics-sentiment" aria-live="polite">
    <span class="analytics-sentiment__title">This month’s mood mix</span>
    <span class="sentiment-count sentiment-count--positive"><i></i>Positive <b id="analytics-positive">0</b></span>
    <span class="sentiment-count sentiment-count--neutral"><i></i>Neutral <b id="analytics-neutral">0</b></span>
    <span class="sentiment-count sentiment-count--negative"><i></i>Negative <b id="analytics-negative">0</b></span>
    <span class="analytics-sentiment__note">Positive: Happy, Calm, Excited · Neutral: Neutral, Tired · Negative: Anxious, Sad, Angry</span>
  </div>

  <div class="analytics-card" aria-live="polite">
    <div class="analytics-card__top">
      <div>
        <h3 id="analytics-period-title">Mood Overview: This Week</h3>
        <p class="muted small" id="analytics-period-subtitle">Your mood by day, Monday to Sunday.</p>
      </div>
      <div class="period-controls">
        <button class="period-button" id="analytics-previous" type="button" aria-label="Previous week">‹</button>
        <span class="period-label" id="analytics-period-label">Loading…</span>
        <button class="period-button" id="analytics-next" type="button" aria-label="Next week" disabled>›</button>
      </div>
    </div>

    <p class="analytics-error is-hidden" id="analytics-error" role="alert"></p>
    <p class="analytics-empty is-hidden" id="analytics-empty" role="status"></p>
    <div class="analytics-chart-wrap" id="analytics-chart-wrap">
      <svg class="analytics-chart" id="weekly-chart" role="img" aria-label="Weekly mood chart"></svg>
      <svg class="analytics-chart is-hidden" id="monthly-chart" role="img" aria-label="Monthly mood distribution chart"></svg>
    </div>
    <p class="analytics-footnote" id="analytics-footnote">Gaps mean no mood was recorded; they are not scored as zero.</p>
  </div>
</section>

<script src="/js/dashboard.js"></script>
<script src="/js/analytics.js"></script>

<%- include('../partials/footer') %>
