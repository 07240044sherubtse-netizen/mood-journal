<%- include('../partials/header', { title: 'Choose a new password', pageClass: 'page--narrow' }) %>

<div class="card">
  <h1>Choose a new password</h1>
  <p class="muted">This link works once and expires one hour after it was sent.</p>

  <% if (locals.error) { %>
    <p class="alert alert--error" role="alert"><%= error %></p>
  <% } %>

  <form class="form" action="/reset-password/<%= token %>" method="post">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

    <label for="password">New password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8">
    <p class="hint">At least 8 characters.</p>

    <label for="confirmPassword">Confirm new password</label>
    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required minlength="8">

    <button class="btn btn--primary" type="submit">Save my new password</button>
  </form>
</div>

<%- include('../partials/footer') %>
