{
  "name": "mood-journal",
  "version": "1.0.0",
  "description": "MoodJournal - a daily mood tracker with a colourful calendar and a streak system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch .env --watch app.js --watch server.js --watch config --watch controllers --watch models --watch routes --watch middleware --watch views --watch public --watch utils server.js",
    "test": "jest",
    "test-db": "node test-db.js",
    "create-admin": "node scripts/createSuperAdmin.js"
  },
  "keywords": [
    "mood",
    "journal",
    "express",
    "ejs",
    "postgres"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14",
    "pg-promise": "^11.9.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
