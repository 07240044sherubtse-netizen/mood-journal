# MoodJournal - test environment.
# Copy this file to .env.test and fill in your own values.
#   Copy-Item .env.test.example .env.test
#
# The tests empty their tables between tests, so DB_NAME MUST end in "_test".
# Create the test database once:
#   createdb -U postgres mood_journal_test
# (The tables themselves are created automatically by tests/globalSetup.js.)

NODE_ENV=test
TIMEZONE=Asia/Thimphu
BASE_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mood_journal_test
DB_USER=postgres
DB_PASS=your-database-password
DB_SSL=false

# Any long random string - it is only used by the test sessions.
SESSION_SECRET=test-session-secret-change-me

# Leave these empty. The tests replace config/mailer with a fake, so no real
# email is ever sent and nothing is printed in the terminal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
